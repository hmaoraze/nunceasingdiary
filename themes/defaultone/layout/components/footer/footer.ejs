<footer class="footer mt-5 py-5 h-auto text-base text-third-text-color relative border-t-2 border-t-border-color">
    <div class="info-container py-3 text-center" style="max-width: 800px; margin: 0 auto;">

        <!-- ====== 自定义页脚信息 ====== -->
        <% if (theme.footer.hasOwnProperty('customize') && theme.footer.customize) { %>
            <div class="customize-info my-1"><%- theme.footer.customize %></div>
        <% } %>

        <!-- ====== 版权信息 + 统计数据 ====== -->
        <div class="my-2">
            &copy;
            <% if (theme.footer.hasOwnProperty('start') && theme.footer.start) { %>
              <span><%= date(new Date(theme.footer.start), 'YYYY') %></span>
              -
            <% } %>
            <%= date(new Date(), 'YYYY') %>
            &nbsp;
            <%- theme.footer.icon || '<i class="fa-regular fa-computer-classic"></i>' %>
            &nbsp;
            <a href="<%= config.root %>" style="font-weight: 500;"><%= theme.info.author || config.author %></a>
            <% if (theme.footer.hasOwnProperty('statistics') && theme.footer.statistics) {%>
                <%
                    const sitePostsCount = site.posts.length;
                    let siteWordCount = null;
                    try {
                        siteWordCount = totalcount(site);
                    } catch (e) {
                        siteWordCount = null;
                    }
                %>
                <span class="post-count" style="margin-left: 4px;">
                    &nbsp;|&nbsp;
                    <%- __("site_posts", sitePostsCount) %>
                    <% if (siteWordCount) {%>
                        &nbsp;|&nbsp;
                        <%- __("site_wordcount", siteWordCount) %>
                    <% } %>
                </span>
            <% } %>
        </div>

        <!-- ====== Powered by ====== -->
        <div class="my-2" style="font-size: 0.875rem; opacity: 0.8;">
            Powered by
            <a target="_blank" href="https://hexo.io" title="Hexo">Hexo</a>
            ※ Theme is
            <a target="_blank" href="https://github.com/EvanNotFound/hexo-theme-redefine" title="Redefine">Redefine</a>
            ※ Enhanced by
            <a href="<%= config.root %>" title="<%= theme.info.author || config.author %>"><%= theme.info.author || config.author %></a>
        </div>

        <!-- ====== 备案号（ICP + 公安 同行显示） ====== -->
        <%
        const hasIcp = theme.footer.icp.enable && theme.footer.icp.hasOwnProperty('number');
        const hasPolice = theme.footer.policemen.enable && theme.footer.policemen.number;
        %>
        <% if (hasIcp || hasPolice) { %>
            <div class="beian-info my-1" style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0 8px; font-size: 0.8rem; opacity: 0.7;">
                <!-- ICP 备案号 -->
                <% if (hasIcp) { %>
                    <span class="beian-item" style="white-space: nowrap;">
                        <a target="_blank" rel="nofollow" href="
                            <% if (theme.footer.icp.hasOwnProperty('url') && theme.footer.icp.url) { %>
                                <%= theme.footer.icp.url %>
                            <% } else { %>
                                https://beian.miit.gov.cn
                            <% } %>
                        ">
                        <img src="https://cdn-pisrl.timens.cn/pxmagic/timenscn/image/icp.png" alt="工信部图标" style="display:inline-block;vertical-align:middle;margin-right:4px;" width="20" height="20" loading="lazy"><%= theme.footer.icp.number %></a>
                    </span>
                <% } %>
                <!-- 分隔符：宽屏显示 | 窄屏隐藏 -->
                <% if (hasIcp && hasPolice) { %>
                    <span class="beian-sep" style="opacity: 0.5;">|</span>
                <% } %>
                <!-- 公安备案号（含数字提取） -->
                <% if (hasPolice) { %>
                    <span class="beian-item" style="white-space: nowrap;">
                        <img src="https://cdn.timens.cn/pxmagic/timenscn/image/goan.png!/format/webp/fw/20/fh/20" alt="公安图标" style="display:inline-block;vertical-align:middle;margin-right:4px;" width="20" height="20" loading="lazy">
                        <a target="_blank" rel="nofollow" href="
                            <% if (theme.footer.policemen.url) { %>
                                <%= theme.footer.policemen.url %>?recordcode=<%= theme.footer.policemen.number.replace(/[^\d]/g, '') %>
                            <% } else { %>
                                http://www.beian.gov.cn/portal/registerSystemInfo?recordcode=<%= theme.footer.policemen.number.replace(/[^\d]/g, '') %>
                            <% } %>
                        "><%= theme.footer.policemen.number %></a>
                    </span>
                <% } %>
            </div>
            <!-- 窄屏适配：分隔符隐藏 + 竖向排列 -->
            <style <%= theme.global.single_page === true && 'data-swup-reload-script' %>>
                @media (max-width: 640px) {
                    .beian-sep { display: none; }
                    .beian-info { flex-direction: column; gap: 2px; }
                }
            </style>
        <% } %>

        <!-- ====== 网站认证与服务标识 ====== -->
        <div class="site-verifications my-3" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 18px; align-items: center; line-height: 1.6;">
            <a href="https://status.hsmao.cn" title="系统状态" target="_blank" rel="noopener" class="footer-link">系统状态</a>

            <a href="https://ipv6test.wcode.net/?q=<%= new URL(config.url).hostname %>" title="本站支持 IPv6 访问" target="_blank" rel="noopener" style="display: inline-flex; align-items: center;">
                <img style="display:inline-block;vertical-align:middle" alt="本站支持 IPv6 访问" src="https://cdn.timens.cn/img/icon-ipv6.svg" height="20">
            </a>

            <a href="https://http3.wcode.net/?q=<%= new URL(config.url).hostname %>" title="支持 HTTP/3 (QUIC)" target="_blank" rel="noopener" style="display: inline-flex; align-items: center;">
                <img src="https://cdn.timens.cn/img/quic.svg" alt="支持 HTTP/3" style="max-width: 100%; height: 20px;">
            </a>

            <a href="https://www.upyun.com/?utm_source=lianmeng&utm_medium=referral" title="又拍云 CDN" target="_blank" rel="noopener" style="display: inline-flex; align-items: center;">
                <img src="https://image.hsmao.cn/blog/up/upyun_logo.png!/format/webp/fw/50/fh/50" alt="又拍云" height="28">
            </a>
            <a href="https://www.travellings.cn/go.html" title="开往 - 友链接力" target="_blank" rel="noopener" style="display: inline-flex; align-items: center;">
                <img src="https://image.hsmao.cn/blog/img/travellings.svg" alt="Travellings" width="80" height="20" style="display:block;">
            </a>
            <a href="https://www.foreverblog.cn/blog/5821.html" title="ForeverBlog 十年之约" target="_blank" rel="noopener" style="display: inline-flex; align-items: center;">
                <img src="https://image.hsmao.cn/blog/img/foreverblog_logo_en_default.png!/format/webp/fw/115/fh/16" alt="ForeverBlog" height="16">
            </a>
        </div>

        <!-- ====== TrustAsia 安全签章 ====== -->
        <div title="TrustAsia 安全签章" id="myssl_seal" onclick="window.open('https://seal.trustasia.com/seal/detail?domain=blog.imce.cn','TrustAsia 安全签章','height=800,width=470,top=0,right=0,toolbar=no,menubar=no,scrollbars=no,resizable=no,location=no,status=no')" style="text-align: center">
            <img src="https://sealres.trustasia.com/seal/img/1x/seal.png?domain=blog.imce.cn" alt="TrustAsia 安全签章" style="width: 130px;height: auto; cursor: pointer">
        </div>

        <!-- ====== 社交媒体链接（已注释，不显示） ====== -->
        <!--
        <div class="social-links my-3">
            <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; font-size: 1.25rem;">
                <span class="footer-social-icon" title="QQ: 1459037075" aria-label="QQ">
                    <i class="fa-brands fa-qq"></i>
                </span>
                <span class="footer-social-icon" title="微信" aria-label="微信">
                    <i class="fa-brands fa-weixin"></i>
                </span>
                <a href="https://space.bilibili.com/3339116" target="_blank" rel="noopener" class="footer-social-icon" title="哔哩哔哩" aria-label="哔哩哔哩">
                    <i class="fa-brands fa-bilibili"></i>
                </a>
                <a href="https://github.com/hsmaocn" target="_blank" rel="noopener" class="footer-social-icon" title="GitHub: hsmaocn" aria-label="GitHub">
                    <i class="fa-brands fa-github"></i>
                </a>
                <a href="mailto:i@hsmao.cn" class="footer-social-icon" title="邮箱：i@hsmao.cn" aria-label="邮箱">
                    <i class="fa-solid fa-envelope"></i>
                </a>
                <a href="https://www.hsmao.cn" target="_blank" rel="noopener" class="footer-social-icon" title="个人主页" aria-label="个人主页">
                    <i class="fa-solid fa-house"></i>
                </a>
            </div>
        </div>
        -->

        <!-- ====== 网站运行时间 ====== -->
        <% if (theme.footer.runtime === true) {%>
            <div class="runtime-info" style="font-size: 0.9rem; opacity: 0.75;">
                <span>小破站已运行</span>
                <span class="odometer" id="runtime_days"></span> 天
                <span class="odometer" id="runtime_hours"></span> 时
                <span class="odometer" id="runtime_minutes"></span> 分
                <span class="odometer" id="runtime_seconds"></span> 秒
            </div>
            <script <%= theme.global.single_page === true && 'data-swup-reload-script' %>>
                try {
                    function odometer_init() {
                        const elements = document.querySelectorAll('.odometer');
                        elements.forEach(el => {
                            new Odometer({
                                el,
                                format: '( ddd).dd',
                                duration: 200
                            });
                        });
                    }
                    odometer_init();
                } catch (error) {}
            </script>
        <% } %>

        <!-- ====== 自定义注入 ====== -->
        <% if (theme.inject.enable === true) { %>
            <% for (let i in theme.inject.footer) { %>
                <% if (theme.inject.footer[i] !== null ){ %>
                    <% if (theme.global.single_page === true) { %>
                        <%- theme.inject.footer[i].replace("<script", "<script data-swup-reload-script") %>
                    <% } else { %>
                        <%- theme.inject.footer[i] %>
                <% } } %>
        <% } }%>

        <!-- ====== 页脚链接悬停效果样式 ====== -->
        <style <%= theme.global.single_page === true && 'data-swup-reload-script' %>>
            .footer a { color: inherit; text-decoration: none; transition: opacity 0.3s, color 0.3s; }
            .footer a:hover { opacity: 0.7; color: var(--primary-color, #009688); }
            .footer-link { cursor: pointer; transition: opacity 0.3s; }
            .footer-link:hover { opacity: 0.7; }
            .footer-social-icon { color: inherit; text-decoration: none; cursor: pointer; transition: opacity 0.2s, transform 0.2s; display: inline-flex; align-items: center; }
            .footer-social-icon:hover { opacity: 0.7; transform: translateY(-2px); }
        </style>
    </div>
</footer>
